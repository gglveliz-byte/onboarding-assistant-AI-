# =============================================================================
# ONBOARDING ASSISTANT AI - PLANTILLA OFICIAL DE VARIABLES DE ENTORNO (.env.example)
# =============================================================================
# Contrato de borde validado estrictamente por `src/config/env.schema.ts`.
# Toda variable marcada como [OBLIGATORIA] detiene el arranque del proceso si falta.
# NUNCA subas el archivo `.env` real a Git: contiene credenciales de produccion.
# =============================================================================

# =============================================================================
# 1. APLICACION Y NODE POOL (Cada proceso declara su rol de pool)
# =============================================================================
# [OBLIGATORIA] development | test | production
NODE_ENV=development
# [OPCIONAL] Puerto HTTP del API Control Plane
PORT=3000
# [OPCIONAL] Puerto WebSocket binario del Voice Realtime Gateway
VOICE_WS_PORT=3001
# [OPCIONAL] Puerto WebSocket del Visual Trainer Orchestrator
TRAINER_WS_PORT=3002
# [OBLIGATORIA] API_CONTROL_PLANE | VOICE_REALTIME_GATEWAY | VISUAL_TRAINER_ORCHESTRATOR
NODE_POOL_ROLE=API_CONTROL_PLANE
# [OPCIONAL] fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# =============================================================================
# 2. BASE DE DATOS (POSTGRESQL / NEON SERVERLESS)
# =============================================================================
# [OBLIGATORIA] Requiere sslmode=require. El esquema se aplica con `npm run db:migrate`.
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# [OPCIONAL] Tamano maximo del pool (1-200)
DATABASE_POOL_MAX=20
# [OPCIONAL] Tiempo maximo por sentencia en milisegundos
DATABASE_STATEMENT_TIMEOUT_MS=15000
# [OPCIONAL] true en produccion: exige certificado TLS valido del servidor
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# =============================================================================
# 3. REDIS (CACHE, CUOTAS TOKEN BUCKET Y SESIONES DE VOZ)
# =============================================================================
# [OBLIGATORIA] Lista de nodos separada por comas (uno o varios nodos del cluster)
REDIS_CLUSTER_URLS=redis://localhost:6379
# [OPCIONAL] Prefijo obligatorio de todas las claves de la plataforma
REDIS_KEY_PREFIX=oa
# [OPCIONAL] Timeout de conexion en milisegundos
REDIS_CONNECT_TIMEOUT_MS=5000

# =============================================================================
# 4. IDENTIDAD: PAR DE LLAVES EdDSA (Ed25519) PARA JWT ASIMETRICO
# =============================================================================
# [OBLIGATORIA EN PRODUCCION] Llave privada PKCS#8 codificada en Base64 (una sola linea).
# Generar con: node -e "const{generateKeyPairSync}=require('node:crypto');const p=generateKeyPairSync('ed25519');console.log(Buffer.from(p.privateKey.export({format:'pem',type:'pkcs8'})).toString('base64'))"
JWT_EDDSA_PRIVATE_KEY_PEM=REEMPLAZAR_POR_LLAVE_PRIVADA_ED25519_EN_BASE64
# [OBLIGATORIA EN PRODUCCION] Llave publica SPKI codificada en Base64 (se publica en el endpoint JWKS).
JWT_EDDSA_PUBLIC_KEY_PEM=REEMPLAZAR_POR_LLAVE_PUBLICA_ED25519_EN_BASE64
# [OPCIONAL] Emisor y audiencia de los tokens de acceso
JWT_ISSUER=onboarding-assistant
JWT_AUDIENCE=onboarding-assistant-api
# [OPCIONAL] Vigencia del token de acceso en segundos (15 minutos por defecto)
JWT_ACCESS_TOKEN_TTL_SECONDS=900
# [OPCIONAL] Vigencia del refresh token rotativo en dias
JWT_REFRESH_TOKEN_TTL_DAYS=30
# [OPCIONAL] Piso temporal anti-enumeracion de usuarios para Argon2id
ARGON2_TIMING_FLOOR_MS=350

# =============================================================================
# 5. COBROS Y SUSCRIPCIONES (CHECKOUT Y FIRMA DE WEBHOOKS)
# =============================================================================
# [OBLIGATORIA] Identificador publico del app. NO es una credencial de operacion: la API de
# cobros rechaza esta clave con 403/400; existe solo para el enlace publico del widget.
WHOP_API_KEY=reemplazar_por_clave_de_api_de_cobros
# [OBLIGATORIA] Clave de API de la EMPRESA (dashboard -> Settings -> API Keys). Es la UNICA
# credencial con permisos sobre checkout_configurations, plans, memberships y webhooks.
WHOP_COMPANY_API_KEY=reemplazar_por_clave_de_api_de_la_empresa
# [OBLIGATORIA] Identificador de la empresa en la pasarela, con prefijo biz_
WHOP_COMPANY_ID=biz_reemplazar_por_identificador_de_empresa
# [OPCIONAL] Producto al que se asociaran los planes creados por la plataforma, prefijo prod_
WHOP_PRODUCT_ID=prod_reemplazar_por_identificador_de_producto
# [OBLIGATORIA] Secreto de firma de los webhooks entrantes (minimo 24 caracteres). Usar el valor
# integro tal como lo muestra la pasarela: no quitar el prefijo ws_ ni codificarlo en base64.
WHOP_WEBHOOK_SECRET=reemplazar_por_secreto_de_firma_de_webhooks
# [OBLIGATORIA] Secreto interno para firmar los enlaces de checkout emitidos por el backend
INTERNAL_CHECKOUT_HMAC_SECRET=reemplazar_por_secreto_interno_de_checkout_min32
# [OPCIONAL] Endpoints base del proveedor de cobros
WHOP_API_BASE_URL=https://api.whop.com
WHOP_CHECKOUT_BASE_URL=https://whop.com/checkout
# [OPCIONAL] Tolerancia anti-replay para la marca temporal de la firma (segundos)
WHOP_WEBHOOK_TOLERANCE_SECONDS=300
# [OPCIONAL] Comision de la pasarela que se traslada al cliente para que el NETO que liquida en el
# panel de la empresa sea exactamente el precio de lista del plan. 0.035 = 2.7% tarjeta + 0.8%
# orquestacion (esta cuenta tiene la orquestacion habilitada).
WHOP_PLATFORM_FEE_PERCENT=0.035
WHOP_PLATFORM_FEE_FIXED_USD=0.30

# =============================================================================
# 6. MOTORES DE VOZ EN TIEMPO REAL (ADAPTADOR PRIMARIO Y DE RESPALDO)
# =============================================================================
# [OBLIGATORIA] Endpoint WebSocket del motor de voz primario
QWEN_REALTIME_WS_URL=wss://dashscope-intl.aliyuncs.com/api-ws/v1/realtime
# [OBLIGATORIA] Credencial del motor de voz primario (minimo 16 caracteres)
QWEN_API_KEY=reemplazar_por_credencial_del_motor_primario
# [OBLIGATORIA] Endpoint WebSocket del motor de voz de respaldo
GEMINI_LIVE_WS_URL=wss://generativelanguage.googleapis.com/ws/google.ai.generativelanguage.v1beta.GenerativeService.BidiGenerateContent
# [OBLIGATORIA] Credencial del motor de voz de respaldo (minimo 16 caracteres)
GEMINI_API_KEY=reemplazar_por_credencial_del_motor_respaldo
# [OPCIONAL] QWEN | GEMINI (motor que atiende la primera conexion)
VOICE_PROVIDER_PRIMARY=QWEN
# [OPCIONAL] Presupuesto maximo de conmutacion por failover (milisegundos)
VOICE_PROVIDER_FAILOVER_BUDGET_MS=800
# [OPCIONAL] Presupuesto maximo de corte por interrupcion del usuario (milisegundos)
VOICE_BARGE_IN_BUDGET_MS=50
# [OPCIONAL] Frecuencia de muestreo del audio PCM16 (Hz)
VOICE_PCM_SAMPLE_RATE_HZ=16000
# [OPCIONAL] Numero maximo de tramas conservadas en el ring buffer volatil de RAM
VOICE_RING_BUFFER_MAX_FRAMES=512
# [OPCIONAL] Duracion maxima facturable de una sesion de voz (minutos)
VOICE_SESSION_MAX_MINUTES=60

# =============================================================================
# 7. NAVEGADOR DE ENTRENAMIENTO REMOTO Y ESCUDO ANTI-SSRF
# =============================================================================
# [OBLIGATORIA] Endpoint del contenedor aislado que ejecuta el navegador efimero
CHROMIUM_DMZ_ENDPOINT=https://chromium-dmz.internal:9222
# [OPCIONAL] Imagen versionada del contenedor del navegador efimero
CHROMIUM_CONTAINER_IMAGE=onboarding-assistant/chromium-dmz:1.0.0
# [OPCIONAL] Tiempo de vida maximo de una sesion de entrenamiento (segundos)
CHROMIUM_SESSION_TTL_SECONDS=300
# [OPCIONAL] Resolutores DNS externos usados por el DNS Pinning (separados por comas)
EXTERNAL_DNS_RESOLVERS=1.1.1.1,8.8.8.8
# [OPCIONAL] Timeout de resolucion DNS en milisegundos
SSRF_DNS_LOOKUP_TIMEOUT_MS=3000
# [OPCIONAL] PROHIBIDO en produccion: jamas habilitar acceso a rangos de red privada
SSRF_ALLOW_PRIVATE_NETWORKS=false

# =============================================================================
# 8. ENDPOINTS PUBLICOS, DEMO COMERCIAL Y CUOTAS
# =============================================================================
# [OPCIONAL] URL publica base del API (usada en enlaces de checkout y demo)
PUBLIC_API_BASE_URL=http://127.0.0.1:3000
# [OPCIONAL] URL publica del gateway de voz (ws:// o wss://); la demo anonima entrega este destino
PUBLIC_VOICE_WS_URL=ws://127.0.0.1:3002/ws/v1/realtime
# [OPCIONAL] Duracion maxima de una sesion de demostracion publica (segundos)
PUBLIC_DEMO_SESSION_MAX_SECONDS=120
# [OPCIONAL] Limite de sesiones de demostracion por hora y por direccion
PUBLIC_DEMO_RATE_LIMIT_PER_HOUR=20
# [OPCIONAL] Origenes autorizados para el SDK y los paneles (separados por comas)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
